# Copy to backend/.env (git-ignored) and fill in real values locally.
# NEVER commit backend/.env or paste real values into source code.
# Do not wrap values in quotes.

# Which provider the backend uses:
#   duckdb    = local development only (no account needed)
#   snowflake = real Snowflake queries (required for the final PS1 submission)
DATAMIND_PROVIDER=duckdb

# Optional: override the local DuckDB file location
# DATAMIND_DUCKDB_PATH=

# Set to 1 to run backend/tests/test_snowflake_live.py against real Snowflake
DATAMIND_SNOWFLAKE_LIVE=0

# --- Snowflake connection (all six are required) ---
SNOWFLAKE_ACCOUNT=<orgname>-<accountname>
SNOWFLAKE_USER=DATAMIND_SVC
# Must be a dedicated read-only role (USAGE + SELECT only). App-side SQL
# validation is NOT a security boundary.
SNOWFLAKE_ROLE=DATAMIND_READONLY
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_DATABASE=DATAMIND
SNOWFLAKE_SCHEMA=PUBLIC

# --- Authentication: choose ONE ---
# Option A (preferred): key-pair. The key file must live OUTSIDE the repo,
# e.g. C:\Users\<you>\.snowflake\datamind_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PATH=
# Only if the key was generated with --passphrase:
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Option B (fallback): password. Ignored when SNOWFLAKE_PRIVATE_KEY_PATH is set.
SNOWFLAKE_PASSWORD=

# --- Gemma via local Ollama (question -> SQL). All optional. ---
# Install Ollama, then: ollama pull gemma3:1b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# DATAMIND_GEMMA_MODEL=gemma3:1b
# Seconds allowed per generation (CPU-only laptops can be slow on first load)
# DATAMIND_GEMMA_TIMEOUT=120
