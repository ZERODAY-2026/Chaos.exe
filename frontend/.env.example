# Base URL of the DataMind FastAPI backend (no trailing slash).
# Public: this value is shipped to the browser. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "true" to start in demo mode (sample fixtures, clearly labeled, no backend needed).
# Demo mode can also be switched on from Settings at runtime.
NEXT_PUBLIC_DEMO_MODE=false
